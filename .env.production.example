# Copie para .env.production apenas em implantações manuais.
# No GitHub Actions, estes valores vêm dos secrets do environment production.
POSTGRES_USER=kiarafin
POSTGRES_PASSWORD=troque-por-uma-senha-forte
POSTGRES_DB=kiarafin
JWT_KEY=troque-por-uma-chave-com-pelo-menos-32-bytes
PUBLIC_ORIGIN=https://financas.exemplo.com.br
FRONTEND_PORT=3333
BACKEND_PORT=3334

# O frontend precisa ser alcançável pelo container do Nginx Proxy Manager.
FRONTEND_BIND_ADDRESS=0.0.0.0

# A API é consumida internamente pelo frontend. Mude para 0.0.0.0 somente se
# realmente precisar publicar um domínio separado para ela.
BACKEND_BIND_ADDRESS=127.0.0.1

# Open Finance / Meu Pluggy. Permanece desabilitado até todas as configurações
# abaixo serem preenchidas e a ativação ser confirmada na interface.
PLUGGY_ENABLED=false
PLUGGY_BASE_URL=https://api.pluggy.ai
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_ITEM_ID=
PLUGGY_WEBHOOK_SECRET=
PLUGGY_AUTHORIZED_EMAIL=jhoownogueira@outlook.com
PLUGGY_SYNC_INTERVAL_HOURS=24
